# ctrld configuration for Alta Labs Route 10
# Copy this file to /cfg/ctrld.toml and replace <YOUR_RESOLVER_ID>
#
# Supported upstream types:
#   doh3 = DNS-over-HTTPS/3 (HTTP/3, QUIC transport) [recommended]
#   doq  = DNS-over-QUIC (native QUIC)
#   doh  = DNS-over-HTTPS (HTTP/2)
#   dot  = DNS-over-TLS

[service]
    log_level = "notice"
    cache_enable = true
    cache_size = 4096
    # Client discovery methods - all enabled for best hostname visibility
    discover_dhcp = true
    discover_ptr = true
    discover_mdns = true
    discover_arp = true
    discover_hosts = true
    discover_refresh_interval = 60
    # dnsmasq lease file location on Alta Route 10
    dhcp_lease_file_path = "/cfg/dhcp.leases"
    dhcp_lease_file_format = "dnsmasq"

[network.0]
    cidrs = ["0.0.0.0/0"]
    name = "Everyone"

# Add narrower networks only when a split-DNS policy references them, and use
# your router's real VLAN subnets — `sh /cfg/status.sh` lists them per bridge.
# Example:
# [network.1]
#     cidrs = ["192.168.10.0/24"]
#     name = "VLAN 10"

[upstream.0]
    bootstrap_ip = "76.76.2.22"
    endpoint = "https://dns.controld.com/<YOUR_RESOLVER_ID>"
    name = "ControlD"
    timeout = 5000
    type = "doh3"
    send_client_info = true

[listener.0]
    ip = "0.0.0.0"
    port = 5354
