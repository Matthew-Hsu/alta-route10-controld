#!/bin/sh
# ControlD DNS with per-device visibility on Alta Labs Route 10
# Copy this file to /cfg/post-cfg.sh and replace <YOUR_RESOLVER_ID>
# This script runs on every boot and re-applies the configuration.
# Supports DoH, DoH3 (HTTP/3), and DoQ (QUIC) via ctrld.

# Keep https-dns-proxy on ControlD as the fallback, but only while Use DoH is
# on in Alta's DNS settings. The firmware says which in dnsmasq's servers: the
# local https-dns-proxy ports when it is on, the ISP's alone when it is off.
# dnsmasq's servers are the firmware's to set, so they are not touched here.
case " $(uci -q get 'dhcp.@dnsmasq[0].server' 2>/dev/null) " in
    *" 127.0.0.1#"*)
        # Wait for https-dns-proxy to initialize. Bounded: the firmware runs
        # this file itself while applying its config, so a loop that never
        # ends here stalls the router's own boot.
        n=0
        while ! uci get https-dns-proxy.@https-dns-proxy[0] >/dev/null 2>&1 && [ $n -lt 30 ]; do
            sleep 1
            n=$((n + 1))
        done

        # Every instance the firmware configured, one per DoH server
        i=0
        while uci -q get "https-dns-proxy.@https-dns-proxy[$i]" >/dev/null 2>&1 && [ $i -lt 16 ]; do
            uci set "https-dns-proxy.@https-dns-proxy[$i].resolver_url=https://dns.controld.com/<YOUR_RESOLVER_ID>"
            uci set "https-dns-proxy.@https-dns-proxy[$i].bootstrap_dns=76.76.2.22"
            i=$((i + 1))
        done
        uci commit https-dns-proxy
        # Also what starts it: firmware 1.5h stops it on every settings save
        /etc/init.d/https-dns-proxy restart
        ;;
esac

# Wait up to 60 seconds for the network, then carry on. An upstream that
# drops ICMP never answers a ping, and the health check below decides whether
# the redirects go in either way.
n=0
while ! ping -c1 76.76.2.22 >/dev/null 2>&1 && [ $n -lt 30 ]; do
    sleep 2
    n=$((n + 1))
done

# Start ctrld as daemon with config file
nohup /cfg/ctrld run -c /cfg/ctrld.toml -d >/dev/null 2>&1 &

# Wait for ctrld to be ready (up to 15s)
n=0
while [ $n -lt 15 ]; do
    if nslookup google.com 127.0.0.1#5354 >/dev/null 2>&1; then
        break
    fi
    sleep 1
    n=`expr $n + 1`
done

# Only redirect DNS if ctrld is confirmed working
if nslookup google.com 127.0.0.1#5354 >/dev/null 2>&1; then
    # Redirect LAN DNS traffic to ctrld (preserves source IP for per-device
    # visibility). One rule pair per LAN bridge: Alta names VLAN bridges
    # br-lan_<vlan-id>, and any bridge without a rule keeps resolving around
    # ctrld — those clients never appear as devices in ControlD.
    #
    # Inserted at the head of PREROUTING. A firewall zone chain can carry a DNS
    # redirect of its own, and a rule appended below it never sees the packet,
    # so the bridge looks covered while its queries go elsewhere.
    for iface in /sys/class/net/br-lan /sys/class/net/br-lan_*; do
        [ -e "$iface" ] || continue
        iface="${iface##*/}"
        iptables -t nat -C PREROUTING -i "$iface" -p udp --dport 53 -j REDIRECT --to-port 5354 2>/dev/null || \
            iptables -t nat -I PREROUTING 1 -i "$iface" -p udp --dport 53 -j REDIRECT --to-port 5354
        iptables -t nat -C PREROUTING -i "$iface" -p tcp --dport 53 -j REDIRECT --to-port 5354 2>/dev/null || \
            iptables -t nat -I PREROUTING 1 -i "$iface" -p tcp --dport 53 -j REDIRECT --to-port 5354
    done
    logger -t post-cfg 'ctrld started (DoH3) with device discovery, DNS redirected to port 5354'
else
    # Fallback: dnsmasq uses https-dns-proxy (already configured above)
    logger -t post-cfg 'ctrld failed health check, using https-dns-proxy fallback'
fi
